# =====================================================================
#  ADHD-Voice-Tasker — environment template
#  Copy to `.env` and fill in, OR run the interactive wizard:
#      python setup_wizard.py
#  Docs: ARCHITECTURE.md
# =====================================================================

# ---- Voice: Deepgram (streaming STT; Nova-3 recommended) ----
# Get a key: https://console.deepgram.com  ($200 free credit, no card)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en
# Optional: Flux conversational turn-detection instead of Nova-3 streaming
# DEEPGRAM_MODEL=flux-general-en

# ---- Ultra-fast LLM loop: Cerebras (WSE, ~2100 tok/s on Llama 70B) ----
# Get a key: https://cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_FAST_MODEL=llama3.1-8b
CEREBRAS_SMART_MODEL=llama-3.3-70b

# ---- Ultra-fast LLM loop: Groq (LPU, sub-100ms TTFT, best realtime) ----
# Get a key: https://console.groq.com
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_SMART_MODEL=llama-3.3-70b-versatile

# ---- LLM Gateway / DevPass (OpenAI-compatible, 200+ models, 1 key) ----
# Get a key: https://llmgateway.io  (key looks like llmgtwy_...)
# Base URL for OpenAI-compatible clients. Claude-Code-style integrations
# use https://api.llmgateway.io (no /v1) as ANTHROPIC_BASE_URL.
LLM_GATEWAY_API_KEY=
LLM_GATEWAY_BASE_URL=https://api.llmgateway.io/v1
LLM_GATEWAY_FAST_MODEL=qwen3.8-flash
LLM_GATEWAY_SMART_MODEL=muse-spark-1.3

# ---- Router defaults ----
# Which provider handles the hot loop (task extract, categorize, dedup)?
# Options: cerebras | groq | gateway
VOICE_PROVIDER=deepgram
FAST_LLM_PROVIDER=cerebras
SMART_LLM_PROVIDER=gateway

# ---- App ----
DATABASE_URL=sqlite:///./data/tasks.db
API_HOST=0.0.0.0
API_PORT=8765

# ---- Windows toast nudges for forgotten tasks ----
TOAST_ENABLED=true
FORGOTTEN_TASK_MINUTES=60

# ---- Agent dispatch (router automations) ----
# Hermes Agent: executable path or HTTP endpoint (either works)
HERMES_AGENT_PATH=
HERMES_AGENT_ENDPOINT=
# Claude Code CLI on PATH (or absolute path to `claude`)
CLAUDE_CODE_PATH=claude
